# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Optional alternative AI providers (configure via server-side Secrets only)
OPENROUTER_API_KEY="MY_OPENROUTER_API_KEY"
ANTHROPIC_API_KEY="MY_ANTHROPIC_API_KEY"
OPENAI_API_KEY="MY_OPENAI_API_KEY"

# ADMIN_PASSWORD: Required for server-side Admin Commands authentication.
# Set a strong unique secret in Google AI Studio Secrets / server environment.
ADMIN_PASSWORD="CHANGE_ME_BEFORE_DEPLOYMENT"

# ADMIN_SESSION_SECRET: Optional HMAC signing secret for Admin HttpOnly cookies.
# If omitted, a random process-scoped secret is generated at server startup.
ADMIN_SESSION_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_STRING"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional Firebase Overrides (defaults to provisioned firebase-applet-config.json)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_DATABASE_ID=""
